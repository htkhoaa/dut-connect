VITE_API_BASE_URL=/api/v1
# Vite proxies /api to this target during local development.
VITE_BACKEND_PROXY_TARGET=http://localhost:8081

# Server-only variables for the Vercel mail relay. Never prefix these with VITE_.
# Set real credentials in Vercel Environment Variables; keep secrets out of Git.
APP_MAIL_ENABLED=false
APP_MAIL_FROM=
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=2525
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
