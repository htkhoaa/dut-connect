{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/mail-relay.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://dut-connect.onrender.com/api/v1/:path*" },
    { "source": "/api/actuator/:path*", "destination": "https://dut-connect.onrender.com/api/actuator/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
