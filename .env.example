# Local development settings for the completed core through Phase 11.
SPRING_PROFILES_ACTIVE=dev
FRONTEND_PORT=80

# PostgreSQL (development credentials only)
POSTGRES_DB=dut_connect
POSTGRES_USER=dut_connect
POSTGRES_PASSWORD=dut_connect_dev
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/dut_connect
SPRING_DATASOURCE_USERNAME=dut_connect
SPRING_DATASOURCE_PASSWORD=dut_connect_dev

# Required: generate a random secret of at least 32 UTF-8 bytes; placeholders fail startup.
APP_JWT_SECRET=replace-with-a-long-random-secret
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=7
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Opt in to create ADMIN once; use an explicit password. Production defaults disabled.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.local
APP_BOOTSTRAP_ADMIN_STUDENT_ID=ADMIN001
APP_BOOTSTRAP_ADMIN_FULL_NAME=System Admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Payment (Phase 7)
PAYMENT_PROVIDER=mock
APP_DONATION_MIN_VND=10000
APP_DONATION_MAX_VND=100000000
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
# Select zalopay only after configuring merchant credentials and a public HTTPS callback.
ZALOPAY_CREATE_ORDER_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_ORDER_URL=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_CALLBACK_URL=
ZALOPAY_REDIRECT_URL=http://localhost/payment/result

# AI (Phase 9)
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_APPLICANTS=20

# Frontend: public build-time settings only; never put secrets in VITE_*.
VITE_API_BASE_URL=/api/v1

# Google Identity Services OAuth client for Web applications
APP_GOOGLE_CLIENT_ID=

# Optional local dev catalog exclusions: comma-separated UUIDs; no data deletion.
APP_DEMO_CATALOG_CAMPAIGN_IDS=
APP_DEMO_CATALOG_PROPOSAL_IDS=
APP_DEMO_CATALOG_ORGANIZATION_IDS=
APP_DEMO_CATALOG_CATEGORY_IDS=
