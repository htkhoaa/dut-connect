// Paste into dbdiagram.io. Exported from PostgreSQL 16 after Flyway V1–V19.
// Flyway remains authoritative; DBML is documentation, not a migration.
Project DUT_Connect {
 database_type: 'PostgreSQL'
 Note: 'Modular monolith. Money is integer VND. Historical public activities are separate from operational records.'
}

Table dut_connect.attendance_records {
 id uuid [pk, not null]
 session_id uuid [not null]
 user_id uuid [not null]
 status varchar(20) [not null]
 recorded_by_user_id uuid [not null]
 recorded_at timestamptz [not null]
 updated_at timestamptz [not null]
 indexes {
  (session_id, user_id) [unique, name: 'uk_attendance_session_user']
 }
 checks {
  `(((status)::text = ANY ((ARRAY['PRESENT'::character varying, 'ABSENT'::character varying])::text[])))` [name: 'attendance_records_status_check']
 }
}

Table dut_connect.attendance_sessions {
 id uuid [pk, not null]
 campaign_id uuid [not null]
 title varchar(200) [not null]
 starts_at timestamptz [not null]
 ends_at timestamptz [not null]
 created_by_user_id uuid [not null]
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 checks {
  `((length(TRIM(BOTH FROM title)) > 0))` [name: 'attendance_sessions_title_check']
  `((ends_at > starts_at))` [name: 'attendance_sessions_check']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_attendance_campaign_start ON dut_connect.attendance_sessions USING btree (campaign_id, starts_at, id)'
}

Table dut_connect.campaign_categories {
 id uuid [pk, not null]
 name varchar(120) [not null]
 slug varchar(140) [not null]
 description varchar(300)
 active boolean [not null, default: `true`]
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 indexes {
  (slug) [unique, name: 'campaign_categories_slug_key']
  (name) [unique, name: 'campaign_categories_name_key']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE UNIQUE INDEX uk_campaign_categories_name ON dut_connect.campaign_categories USING btree (lower((name)::text))'
}

Table dut_connect.campaign_expenses {
 id uuid [pk, not null]
 campaign_id uuid [not null]
 title varchar(200) [not null]
 category varchar(100) [not null]
 amount numeric(19,0) [not null]
 expense_date date [not null]
 description varchar(2000)
 proof_reference varchar(1000)
 status varchar(20) [not null]
 submitted_by_user_id uuid [not null]
 reviewed_by_user_id uuid
 reviewed_at timestamptz
 rejection_reason varchar(1000)
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 checks {
  `((((status)::text <> 'REJECTED'::text) OR ((rejection_reason)::text ~ '[^[:space:]]'::text)))` [name: 'ck_expense_rejection_reason_text']
  `((amount <> 'NaN'::numeric))` [name: 'ck_expense_finite_amount']
  `(((expense_date >= '0001-01-01'::date) AND (expense_date <= '9999-12-31'::date)))` [name: 'ck_expense_calendar_date']
  `((version >= 0))` [name: 'campaign_expenses_version_check']
  `((length(TRIM(BOTH FROM title)) > 0))` [name: 'campaign_expenses_title_check']
  `(((status)::text = ANY ((ARRAY['PENDING'::character varying, 'APPROVED'::character varying, 'REJECTED'::character varying])::text[])))` [name: 'campaign_expenses_status_check']
  `(((((status)::text = 'PENDING'::text) AND (reviewed_by_user_id IS NULL) AND (reviewed_at IS NULL) AND (rejection_reason IS NULL)) OR (((status)::text = 'APPROVED'::text) AND (reviewed_by_user_id IS NOT NULL) AND (reviewed_at IS NOT NULL) AND (rejection_reason IS NULL)) OR (((status)::text = 'REJECTED'::text) AND (reviewed_by_user_id IS NOT NULL) AND (reviewed_at IS NOT NULL) AND (length(TRIM(BOTH FROM rejection_reason)) > 0) AND (rejection_reason IS NOT NULL))))` [name: 'campaign_expenses_check']
  `((length(TRIM(BOTH FROM category)) > 0))` [name: 'campaign_expenses_category_check']
  `((amount > (0)::numeric))` [name: 'campaign_expenses_amount_check']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_expenses_campaign_status ON dut_connect.campaign_expenses USING btree (campaign_id, status, created_at DESC, id)\nCREATE INDEX idx_expenses_status_created ON dut_connect.campaign_expenses USING btree (status, created_at DESC, id)'
}

Table dut_connect.campaign_managers {
 campaign_id uuid [not null]
 user_id uuid [not null]
 manager_role varchar(20) [not null]
 created_at timestamptz [not null]
 indexes {
  (campaign_id, user_id) [pk, name: 'campaign_managers_pkey']
 }
 checks {
  `(((manager_role)::text = ANY ((ARRAY['OWNER'::character varying, 'MANAGER'::character varying])::text[])))` [name: 'campaign_managers_manager_role_check']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE UNIQUE INDEX uk_campaign_owner ON dut_connect.campaign_managers USING btree (campaign_id) WHERE ((manager_role)::text = \'OWNER\'::text)\nCREATE INDEX idx_campaign_managers_user ON dut_connect.campaign_managers USING btree (user_id)'
}

Table dut_connect.campaign_skill_requirements {
 campaign_id uuid [not null]
 skill_id uuid [not null]
 track varchar(20) [not null]
 importance integer [not null, default: `3`]
 indexes {
  (campaign_id, skill_id, track) [pk, name: 'campaign_skill_requirements_pkey']
 }
 checks {
  `(((track)::text = ANY ((ARRAY['TECHNICAL'::character varying, 'LOGISTICS'::character varying])::text[])))` [name: 'campaign_skill_requirements_track_check']
  `(((importance >= 1) AND (importance <= 5)))` [name: 'campaign_skill_requirements_importance_check']
 }
}

Table dut_connect.campaigns {
 id uuid [pk, not null]
 proposal_id uuid [not null]
 slug varchar(240) [not null]
 primary_contact_user_id uuid [not null]
 organizer_type varchar(20) [not null]
 organization_id uuid
 category_id uuid [not null]
 title varchar(200) [not null]
 summary varchar(500) [not null]
 description text [not null]
 expected_impact text
 contribution_mode varchar(30) [not null]
 start_date date [not null]
 end_date date [not null]
 application_deadline timestamptz
 fundraising_deadline timestamptz
 target_volunteer_count integer
 target_technical_count integer
 target_logistics_count integer
 volunteer_requirements text
 fundraising_goal numeric(19,0)
 institutional_funding numeric(19,0) [not null, default: `0`]
 sponsor_name varchar(200)
 sponsor_funding numeric(19,0) [not null, default: `0`]
 estimated_budget numeric(19,0)
 status varchar(20) [not null]
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 indexes {
  (slug) [unique, name: 'campaigns_slug_key']
  (proposal_id) [unique, name: 'campaigns_proposal_id_key']
 }
 checks {
  `(((institutional_funding <> 'NaN'::numeric) AND (sponsor_funding <> 'NaN'::numeric) AND (fundraising_goal <> 'NaN'::numeric) AND (estimated_budget <> 'NaN'::numeric)))` [name: 'ck_campaign_finite_funding']
  `(((target_volunteer_count IS NULL) OR (target_volunteer_count >= 0)))` [name: 'campaigns_target_volunteer_count_check']
  `(((target_technical_count IS NULL) OR (target_technical_count >= 0)))` [name: 'campaigns_target_technical_count_check']
  `(((target_logistics_count IS NULL) OR (target_logistics_count >= 0)))` [name: 'campaigns_target_logistics_count_check']
  `(((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'OPEN'::character varying, 'ACTIVE'::character varying, 'COMPLETED'::character varying, 'CANCELLED'::character varying])::text[])))` [name: 'campaigns_status_check']
  `(((organizer_type)::text = ANY ((ARRAY['INDIVIDUAL'::character varying, 'ORGANIZATION'::character varying])::text[])))` [name: 'campaigns_organizer_type_check']
  `(((fundraising_goal IS NULL) OR (fundraising_goal > (0)::numeric)))` [name: 'campaigns_fundraising_goal_check']
  `(((estimated_budget IS NULL) OR (estimated_budget >= (0)::numeric)))` [name: 'campaigns_estimated_budget_check']
  `(((contribution_mode)::text = ANY ((ARRAY['VOLUNTEER_ONLY'::character varying, 'DONATION_ONLY'::character varying, 'HYBRID'::character varying])::text[])))` [name: 'campaigns_contribution_mode_check']
  `(((target_technical_count IS NULL) OR (target_logistics_count IS NULL) OR (((target_technical_count)::bigint + target_logistics_count) <= target_volunteer_count)))` [name: 'campaigns_check6']
  `((((contribution_mode)::text <> 'VOLUNTEER_ONLY'::text) OR ((fundraising_goal IS NULL) AND (fundraising_deadline IS NULL))))` [name: 'campaigns_check5']
  `((((contribution_mode)::text <> 'DONATION_ONLY'::text) OR ((COALESCE(target_volunteer_count, 0) = 0) AND (COALESCE(target_technical_count, 0) = 0) AND (COALESCE(target_logistics_count, 0) = 0))))` [name: 'campaigns_check4']
  `((((contribution_mode)::text = 'DONATION_ONLY'::text) OR ((target_volunteer_count IS NOT NULL) AND (target_volunteer_count >= 1))))` [name: 'campaigns_check3']
  `(((institutional_funding >= (0)::numeric) AND (sponsor_funding >= (0)::numeric)))` [name: 'campaigns_check2']
  `((end_date >= start_date))` [name: 'campaigns_check1']
  `((((organizer_type)::text = 'ORGANIZATION'::text) = (organization_id IS NOT NULL)))` [name: 'campaigns_check']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_campaigns_status ON dut_connect.campaigns USING btree (status)\nCREATE INDEX idx_campaigns_category ON dut_connect.campaigns USING btree (category_id)\nCREATE INDEX idx_campaigns_organization ON dut_connect.campaigns USING btree (organization_id)\nCREATE INDEX idx_campaigns_mode ON dut_connect.campaigns USING btree (contribution_mode)\nCREATE INDEX idx_campaigns_start ON dut_connect.campaigns USING btree (start_date)'
}

Table dut_connect.donations {
 id uuid [pk, not null]
 campaign_id uuid [not null]
 donor_user_id uuid [not null]
 amount numeric(19,0) [not null]
 status varchar(30) [not null]
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 checks {
  `(((status)::text = ANY ((ARRAY['CREATED'::character varying, 'PENDING_PAYMENT'::character varying, 'PAID'::character varying, 'FAILED'::character varying, 'CANCELLED'::character varying, 'REFUNDED'::character varying])::text[])))` [name: 'donations_status_check']
  `((amount > (0)::numeric))` [name: 'donations_amount_check']
  `((amount <> 'NaN'::numeric))` [name: 'ck_donation_finite_amount']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_donations_campaign_status ON dut_connect.donations USING btree (campaign_id, status)\nCREATE INDEX idx_donations_donor_created ON dut_connect.donations USING btree (donor_user_id, created_at DESC, id)\nCREATE INDEX idx_donations_created ON dut_connect.donations USING btree (created_at)'
}

Table dut_connect.google_auth_challenges {
 id uuid [pk, not null]
 nonce_hash character(64) [not null]
 expires_at timestamptz [not null]
 used_at timestamptz
 created_at timestamptz [not null]
 indexes {
  (nonce_hash) [unique, name: 'google_auth_challenges_nonce_hash_key']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_google_challenges_expiry ON dut_connect.google_auth_challenges USING btree (expires_at)'
}

Table dut_connect.google_identities {
 user_id uuid [pk, not null]
 subject varchar(255) [not null]
 created_at timestamptz [not null]
 indexes {
  (subject) [unique, name: 'google_identities_subject_key']
 }
}

Table dut_connect.meetings {
 id uuid [pk, not null]
 campaign_id uuid [not null]
 title varchar(200) [not null]
 description text
 meeting_type varchar(20) [not null]
 starts_at timestamptz [not null]
 ends_at timestamptz [not null]
 location varchar(300)
 meeting_url varchar(1000)
 created_by_user_id uuid [not null]
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 checks {
  `((length(TRIM(BOTH FROM title)) > 0))` [name: 'meetings_title_check']
  `(((meeting_type)::text = ANY ((ARRAY['ONLINE'::character varying, 'OFFLINE'::character varying])::text[])))` [name: 'meetings_meeting_type_check']
  `((((meeting_type)::text <> 'OFFLINE'::text) OR ((length(TRIM(BOTH FROM location)) > 0) AND (location IS NOT NULL))))` [name: 'meetings_check2']
  `((((meeting_type)::text <> 'ONLINE'::text) OR ((length(TRIM(BOTH FROM meeting_url)) > 0) AND (meeting_url IS NOT NULL))))` [name: 'meetings_check1']
  `((ends_at > starts_at))` [name: 'meetings_check']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_meetings_campaign_start ON dut_connect.meetings USING btree (campaign_id, starts_at, id)'
}

Table dut_connect.organization_members {
 organization_id uuid [not null]
 user_id uuid [not null]
 member_role varchar(20) [not null]
 joined_at timestamptz [not null]
 indexes {
  (organization_id, user_id) [pk, name: 'organization_members_pkey']
 }
 checks {
  `(((member_role)::text = ANY ((ARRAY['OWNER'::character varying, 'MANAGER'::character varying, 'MEMBER'::character varying])::text[])))` [name: 'organization_members_member_role_check']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_organization_members_user ON dut_connect.organization_members USING btree (user_id)'
}

Table dut_connect.organization_types {
 id uuid [pk, not null]
 code varchar(50) [not null]
 name varchar(120) [not null]
 active boolean [not null, default: `true`]
 created_at timestamptz [not null]
 indexes {
  (code) [unique, name: 'organization_types_code_key']
 }
}

Table dut_connect.organizations {
 id uuid [pk, not null]
 name varchar(200) [not null]
 slug varchar(220) [not null]
 organization_type_id uuid [not null]
 description text
 status varchar(30) [not null]
 created_by_user_id uuid [not null]
 verified_by_user_id uuid
 verified_at timestamptz
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 indexes {
  (slug) [unique, name: 'organizations_slug_key']
 }
 checks {
  `(((status)::text = ANY ((ARRAY['PENDING_VERIFICATION'::character varying, 'VERIFIED'::character varying, 'SUSPENDED'::character varying])::text[])))` [name: 'organizations_status_check']
  `((((status)::text = 'PENDING_VERIFICATION'::text) OR (verified_at IS NOT NULL)))` [name: 'organizations_check1']
  `(((verified_by_user_id IS NULL) = (verified_at IS NULL)))` [name: 'organizations_check']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE UNIQUE INDEX uk_organizations_name ON dut_connect.organizations USING btree (lower((name)::text))\nCREATE INDEX idx_organizations_status ON dut_connect.organizations USING btree (status)'
}

Table dut_connect.payment_transactions {
 id uuid [pk, not null]
 donation_id uuid [not null]
 provider varchar(30) [not null]
 status varchar(30) [not null]
 provider_order_id varchar(100) [not null]
 provider_transaction_id varchar(100)
 amount numeric(19,0) [not null]
 checkout_url varchar(2000)
 provider_response_code varchar(100)
 failure_reason varchar(1000)
 expires_at timestamptz
 paid_at timestamptz
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 indexes {
  (provider_transaction_id) [unique, name: 'payment_transactions_provider_transaction_id_key']
  (provider_order_id) [unique, name: 'payment_transactions_provider_order_id_key']
 }
 checks {
  `(((status)::text = ANY ((ARRAY['CREATED'::character varying, 'PROVIDER_PENDING'::character varying, 'PAID'::character varying, 'FAILED'::character varying, 'CANCELLED'::character varying, 'REFUNDED'::character varying])::text[])))` [name: 'payment_transactions_status_check']
  `(((provider)::text = ANY ((ARRAY['mock'::character varying, 'zalopay'::character varying])::text[])))` [name: 'payment_transactions_provider_check']
  `((((status)::text = ANY ((ARRAY['PAID'::character varying, 'REFUNDED'::character varying])::text[])) = (provider_transaction_id IS NOT NULL)))` [name: 'payment_transactions_check1']
  `((((status)::text = ANY ((ARRAY['PAID'::character varying, 'REFUNDED'::character varying])::text[])) = (paid_at IS NOT NULL)))` [name: 'payment_transactions_check']
  `((amount > (0)::numeric))` [name: 'payment_transactions_amount_check']
  `((amount <> 'NaN'::numeric))` [name: 'ck_payment_finite_amount']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_payments_donation ON dut_connect.payment_transactions USING btree (donation_id, created_at DESC, id)\nCREATE INDEX idx_payments_pending ON dut_connect.payment_transactions USING btree (status, expires_at)'
}

Table dut_connect.profile_avatars {
 user_id uuid [pk, not null]
 image_data bytea [not null]
 updated_at timestamptz [not null]
 checks {
  `(((octet_length(image_data) >= 1) AND (octet_length(image_data) <= 262144)))` [name: 'ck_avatar_size']
 }
}

Table dut_connect.proposals {
 id uuid [pk, not null]
 proposer_user_id uuid [not null]
 organizer_type varchar(20) [not null]
 organization_id uuid
 category_id uuid [not null]
 title varchar(200) [not null]
 summary varchar(500) [not null]
 description text [not null]
 expected_impact text
 contribution_mode varchar(30) [not null]
 start_date date [not null]
 end_date date [not null]
 application_deadline timestamptz
 fundraising_deadline timestamptz
 target_volunteer_count integer
 target_technical_count integer
 target_logistics_count integer
 volunteer_requirements text
 fundraising_goal numeric(19,0)
 institutional_funding numeric(19,0) [not null, default: `0`]
 sponsor_name varchar(200)
 sponsor_funding numeric(19,0) [not null, default: `0`]
 estimated_budget numeric(19,0)
 status varchar(20) [not null]
 rejection_reason varchar(1000)
 reviewed_by_user_id uuid
 reviewed_at timestamptz
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 checks {
  `(((target_volunteer_count IS NULL) OR (target_volunteer_count >= 0)))` [name: 'proposals_target_volunteer_count_check']
  `(((target_technical_count IS NULL) OR (target_technical_count >= 0)))` [name: 'proposals_target_technical_count_check']
  `(((target_logistics_count IS NULL) OR (target_logistics_count >= 0)))` [name: 'proposals_target_logistics_count_check']
  `(((status)::text = ANY ((ARRAY['PENDING'::character varying, 'APPROVED'::character varying, 'REJECTED'::character varying])::text[])))` [name: 'proposals_status_check']
  `(((organizer_type)::text = ANY ((ARRAY['INDIVIDUAL'::character varying, 'ORGANIZATION'::character varying])::text[])))` [name: 'proposals_organizer_type_check']
  `(((fundraising_goal IS NULL) OR (fundraising_goal > (0)::numeric)))` [name: 'proposals_fundraising_goal_check']
  `(((estimated_budget IS NULL) OR (estimated_budget >= (0)::numeric)))` [name: 'proposals_estimated_budget_check']
  `(((contribution_mode)::text = ANY ((ARRAY['VOLUNTEER_ONLY'::character varying, 'DONATION_ONLY'::character varying, 'HYBRID'::character varying])::text[])))` [name: 'proposals_contribution_mode_check']
  `(((target_technical_count IS NULL) OR (target_logistics_count IS NULL) OR (((target_technical_count)::bigint + target_logistics_count) <= target_volunteer_count)))` [name: 'proposals_check9']
  `((((contribution_mode)::text <> 'VOLUNTEER_ONLY'::text) OR ((fundraising_goal IS NULL) AND (fundraising_deadline IS NULL))))` [name: 'proposals_check8']
  `((((contribution_mode)::text <> 'DONATION_ONLY'::text) OR ((COALESCE(target_volunteer_count, 0) = 0) AND (COALESCE(target_technical_count, 0) = 0) AND (COALESCE(target_logistics_count, 0) = 0))))` [name: 'proposals_check7']
  `((((contribution_mode)::text = 'DONATION_ONLY'::text) OR ((target_volunteer_count IS NOT NULL) AND (target_volunteer_count >= 1))))` [name: 'proposals_check6']
  `(((institutional_funding >= (0)::numeric) AND (sponsor_funding >= (0)::numeric)))` [name: 'proposals_check5']
  `((end_date >= start_date))` [name: 'proposals_check4']
  `((((organizer_type)::text = 'ORGANIZATION'::text) = (organization_id IS NOT NULL)))` [name: 'proposals_check3']
  `((((status)::text <> 'REJECTED'::text) OR ((rejection_reason IS NOT NULL) AND (length(TRIM(BOTH FROM rejection_reason)) > 0))))` [name: 'proposals_check2']
  `((((status)::text = 'PENDING'::text) OR (reviewed_at IS NOT NULL)))` [name: 'proposals_check1']
  `(((reviewed_by_user_id IS NULL) = (reviewed_at IS NULL)))` [name: 'proposals_check']
  `(((institutional_funding <> 'NaN'::numeric) AND (sponsor_funding <> 'NaN'::numeric) AND (fundraising_goal <> 'NaN'::numeric) AND (estimated_budget <> 'NaN'::numeric)))` [name: 'ck_proposal_finite_funding']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_proposals_status_created ON dut_connect.proposals USING btree (status, created_at)\nCREATE INDEX idx_proposals_proposer ON dut_connect.proposals USING btree (proposer_user_id)'
}

Table dut_connect.published_activities {
 id uuid [pk, not null]
 category varchar(100) [not null]
 content jsonb [not null]
 published_on date [not null]
 image_url varchar(500) [not null]
 source_url varchar(1000) [not null]
 created_at timestamptz [not null, default: `now()`]
 indexes {
  (source_url) [unique, name: 'published_activities_source_url_key']
 }
 checks {
  `(((source_url)::text ~~ 'https://dut.udn.vn/%'::text))` [name: 'ck_activity_source']
  `(((content ? 'vi'::text) AND (content ? 'en'::text)))` [name: 'ck_activity_languages']
  `(((image_url)::text ~~ '/images/%'::text))` [name: 'ck_activity_image']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_activities_publication ON dut_connect.published_activities USING btree (published_on DESC, id)\nCREATE INDEX idx_activities_category ON dut_connect.published_activities USING btree (category)'
}

