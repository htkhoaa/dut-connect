}

Table dut_connect.task_assignees {
 task_id uuid [not null]
 user_id uuid [not null]
 assigned_at timestamptz [not null]
 indexes {
  (task_id, user_id) [pk, name: 'task_assignees_pkey']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_task_assignees_user ON dut_connect.task_assignees USING btree (user_id, task_id)'
}

Table dut_connect.users {
 id uuid [pk, not null]
 student_id varchar(32) [not null]
 email varchar(255) [not null]
 password_hash varchar(255) [not null]
 full_name varchar(150) [not null]
 global_role varchar(20) [not null]
 status varchar(20) [not null]
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 indexes {
  (student_id) [unique, name: 'users_student_id_key']
  (email) [unique, name: 'users_email_key']
 }
 checks {
  `(((status)::text = ANY ((ARRAY['ACTIVE'::character varying, 'SUSPENDED'::character varying])::text[])))` [name: 'users_status_check']
  `(((global_role)::text = ANY ((ARRAY['ADMIN'::character varying, 'USER'::character varying])::text[])))` [name: 'users_global_role_check']
 }
}

Table dut_connect.volunteer_completions {
 id uuid [pk, not null]
 campaign_id uuid [not null]
 user_id uuid [not null]
 status varchar(20) [not null]
 verified_hours numeric(8,2)
 note varchar(1000)
 verified_by_user_id uuid
 verified_at timestamptz
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 indexes {
  (campaign_id, user_id) [unique, name: 'uk_completion_campaign_user']
 }
 checks {
  `((verified_hours >= (0)::numeric))` [name: 'volunteer_completions_verified_hours_check']
  `(((status)::text = ANY ((ARRAY['PENDING'::character varying, 'COMPLETED'::character varying, 'VERIFIED'::character varying])::text[])))` [name: 'volunteer_completions_status_check']
  `(((verified_at IS NULL) = (verified_by_user_id IS NULL)))` [name: 'volunteer_completions_check2']
  `((((status)::text = 'VERIFIED'::text) = (verified_by_user_id IS NOT NULL)))` [name: 'volunteer_completions_check1']
  `((((status)::text <> 'VERIFIED'::text) OR (verified_hours IS NOT NULL)))` [name: 'volunteer_completions_check']
  `((verified_hours <> 'NaN'::numeric))` [name: 'ck_completion_finite_hours']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_completion_campaign_status ON dut_connect.volunteer_completions USING btree (campaign_id, status)\nCREATE INDEX idx_completion_user ON dut_connect.volunteer_completions USING btree (user_id, created_at DESC, id)'
}

Table dut_connect.volunteer_registrations {
 id uuid [pk, not null]
 campaign_id uuid [not null]
 user_id uuid [not null]
 preferred_track varchar(20) [not null]
 assigned_track varchar(20)
 motivation varchar(1000) [not null]
 availability varchar(1000)
 status varchar(20) [not null]
 rejection_reason varchar(1000)
 reviewed_by_user_id uuid
 reviewed_at timestamptz
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 indexes {
  (campaign_id, user_id) [unique, name: 'uk_volunteer_campaign_user']
 }
 checks {
  `(((status)::text = ANY ((ARRAY['PENDING'::character varying, 'ACCEPTED'::character varying, 'REJECTED'::character varying, 'CANCELLED'::character varying])::text[])))` [name: 'volunteer_registrations_status_check']
  `(((rejection_reason IS NULL) OR (length(TRIM(BOTH FROM rejection_reason)) > 0)))` [name: 'volunteer_registrations_rejection_reason_check']
  `(((preferred_track)::text = ANY ((ARRAY['TECHNICAL'::character varying, 'LOGISTICS'::character varying])::text[])))` [name: 'volunteer_registrations_preferred_track_check']
  `((length(TRIM(BOTH FROM motivation)) > 0))` [name: 'volunteer_registrations_motivation_check']
  `((((status)::text = 'REJECTED'::text) = (rejection_reason IS NOT NULL)))` [name: 'volunteer_registrations_check3']
  `(((reviewed_by_user_id IS NULL) = (reviewed_at IS NULL)))` [name: 'volunteer_registrations_check2']
  `((((status)::text = ANY ((ARRAY['ACCEPTED'::character varying, 'REJECTED'::character varying])::text[])) = (reviewed_by_user_id IS NOT NULL)))` [name: 'volunteer_registrations_check1']
  `((((status)::text = 'ACCEPTED'::text) = (assigned_track IS NOT NULL)))` [name: 'volunteer_registrations_check']
  `(((assigned_track)::text = ANY ((ARRAY['TECHNICAL'::character varying, 'LOGISTICS'::character varying])::text[])))` [name: 'volunteer_registrations_assigned_track_check']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_volunteer_campaign_status ON dut_connect.volunteer_registrations USING btree (campaign_id, status)\nCREATE INDEX idx_volunteer_user_created ON dut_connect.volunteer_registrations USING btree (user_id, created_at DESC, id)'
}

Table dut_connect.volunteer_tasks {
 id uuid [pk, not null]
 campaign_id uuid [not null]
 title varchar(200) [not null]
 description text [not null]
 track varchar(20) [not null]
 priority varchar(20) [not null]
 due_at timestamptz
 status varchar(20) [not null]
 created_by_user_id uuid [not null]
 verified_by_user_id uuid
 verified_at timestamptz
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 checks {
  `(((track)::text = ANY ((ARRAY['TECHNICAL'::character varying, 'LOGISTICS'::character varying])::text[])))` [name: 'volunteer_tasks_track_check']
  `((length(TRIM(BOTH FROM title)) > 0))` [name: 'volunteer_tasks_title_check']
  `(((status)::text = ANY ((ARRAY['TODO'::character varying, 'IN_PROGRESS'::character varying, 'DONE'::character varying, 'VERIFIED'::character varying])::text[])))` [name: 'volunteer_tasks_status_check']
  `(((priority)::text = ANY ((ARRAY['LOW'::character varying, 'MEDIUM'::character varying, 'HIGH'::character varying])::text[])))` [name: 'volunteer_tasks_priority_check']
  `((length(TRIM(BOTH FROM description)) > 0))` [name: 'volunteer_tasks_description_check']
  `(((verified_at IS NULL) = (verified_by_user_id IS NULL)))` [name: 'volunteer_tasks_check1']
  `((((status)::text = 'VERIFIED'::text) = (verified_by_user_id IS NOT NULL)))` [name: 'volunteer_tasks_check']
 }
 Note: 'PostgreSQL indexes (including partial/expression indexes):\nCREATE INDEX idx_tasks_campaign_status ON dut_connect.volunteer_tasks USING btree (campaign_id, status, created_at DESC, id)'
}

