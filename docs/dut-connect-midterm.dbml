// DUT Connect — midterm edition. 19 application tables; generated from the running database.
// Flyway history is framework metadata and is not a business table.
Project DUT_Connect_Midterm {
 database_type: 'PostgreSQL'
 Note: '19-table midterm scope. Full 28-table version is preserved on archive/full-28-tables.'
}

Table dut_connect_midterm.attendance_records {
 id uuid [pk, not null]
 session_id uuid [not null]
 user_id uuid [not null]
 status varchar(20) [not null]
 recorded_by_user_id uuid [not null]
 recorded_at timestamptz [not null]
 updated_at timestamptz [not null]
 indexes {
  (session_id, user_id) [unique, name: 'uk_attendance_session_user']
 }
 checks {
  `(((status)::text = ANY ((ARRAY['PRESENT'::character varying, 'ABSENT'::character varying])::text[])))` [name: 'attendance_records_status_check']
 }
 Note: 'CREATE UNIQUE INDEX attendance_records_pkey ON dut_connect_midterm.attendance_records USING btree (id)\nCREATE UNIQUE INDEX uk_attendance_session_user ON dut_connect_midterm.attendance_records USING btree (session_id, user_id)'
}

Table dut_connect_midterm.attendance_sessions {
 id uuid [pk, not null]
 campaign_id uuid [not null]
 title varchar(200) [not null]
 starts_at timestamptz [not null]
 ends_at timestamptz [not null]
 created_by_user_id uuid [not null]
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 checks {
  `((length(TRIM(BOTH FROM title)) > 0))` [name: 'attendance_sessions_title_check']
  `((ends_at > starts_at))` [name: 'attendance_sessions_check']
 }
 Note: 'CREATE UNIQUE INDEX attendance_sessions_pkey ON dut_connect_midterm.attendance_sessions USING btree (id)\nCREATE INDEX idx_attendance_campaign_start ON dut_connect_midterm.attendance_sessions USING btree (campaign_id, starts_at, id)'
}

Table dut_connect_midterm.campaign_categories {
 id uuid [pk, not null]
 name varchar(120) [not null]
 slug varchar(140) [not null]
 description varchar(300)
 active boolean [not null, default: `true`]
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 indexes {
  (slug) [unique, name: 'campaign_categories_slug_key']
  (name) [unique, name: 'campaign_categories_name_key']
 }
 Note: 'CREATE UNIQUE INDEX campaign_categories_pkey ON dut_connect_midterm.campaign_categories USING btree (id)\nCREATE UNIQUE INDEX campaign_categories_name_key ON dut_connect_midterm.campaign_categories USING btree (name)\nCREATE UNIQUE INDEX campaign_categories_slug_key ON dut_connect_midterm.campaign_categories USING btree (slug)\nCREATE UNIQUE INDEX uk_campaign_categories_name ON dut_connect_midterm.campaign_categories USING btree (lower((name)::text))'
}

Table dut_connect_midterm.campaign_managers {
 campaign_id uuid [not null]
 user_id uuid [not null]
 manager_role varchar(20) [not null]
 created_at timestamptz [not null]
 indexes {
  (campaign_id, user_id) [pk, name: 'campaign_managers_pkey']
 }
 checks {
  `(((manager_role)::text = ANY ((ARRAY['OWNER'::character varying, 'MANAGER'::character varying])::text[])))` [name: 'campaign_managers_manager_role_check']
 }
 Note: 'CREATE UNIQUE INDEX campaign_managers_pkey ON dut_connect_midterm.campaign_managers USING btree (campaign_id, user_id)\nCREATE UNIQUE INDEX uk_campaign_owner ON dut_connect_midterm.campaign_managers USING btree (campaign_id) WHERE ((manager_role)::text = \'OWNER\'::text)\nCREATE INDEX idx_campaign_managers_user ON dut_connect_midterm.campaign_managers USING btree (user_id)'
}

Table dut_connect_midterm.campaign_skill_requirements {
 campaign_id uuid [not null]
 skill_id uuid [not null]
 track varchar(20) [not null]
 importance integer [not null, default: `3`]
 indexes {
  (campaign_id, skill_id, track) [pk, name: 'campaign_skill_requirements_pkey']
 }
 checks {
  `(((track)::text = ANY ((ARRAY['TECHNICAL'::character varying, 'LOGISTICS'::character varying])::text[])))` [name: 'campaign_skill_requirements_track_check']
  `(((importance >= 1) AND (importance <= 5)))` [name: 'campaign_skill_requirements_importance_check']
 }
 Note: 'CREATE UNIQUE INDEX campaign_skill_requirements_pkey ON dut_connect_midterm.campaign_skill_requirements USING btree (campaign_id, skill_id, track)'
}

Table dut_connect_midterm.campaigns {
 id uuid [pk, not null]
 proposal_id uuid [not null]
 slug varchar(240) [not null]
 primary_contact_user_id uuid [not null]
 organizer_type varchar(20) [not null]
 organization_id uuid
 category_id uuid [not null]
 title varchar(200) [not null]
 summary varchar(500) [not null]
 description text [not null]
 expected_impact text
 contribution_mode varchar(30) [not null]
 start_date date [not null]
 end_date date [not null]
 application_deadline timestamptz
 fundraising_deadline timestamptz
 target_volunteer_count integer
 target_technical_count integer
 target_logistics_count integer
 volunteer_requirements text
 fundraising_goal numeric(19,0)
 institutional_funding numeric(19,0) [not null, default: `0`]
 sponsor_name varchar(200)
 sponsor_funding numeric(19,0) [not null, default: `0`]
 estimated_budget numeric(19,0)
 status varchar(20) [not null]
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 seed_key varchar(100)
 indexes {
  (slug) [unique, name: 'campaigns_slug_key']
  (seed_key) [unique, name: 'campaigns_seed_key_key']
  (proposal_id) [unique, name: 'campaigns_proposal_id_key']
 }
 checks {
  `(((target_volunteer_count IS NULL) OR (target_volunteer_count >= 0)))` [name: 'campaigns_target_volunteer_count_check']
  `(((target_technical_count IS NULL) OR (target_technical_count >= 0)))` [name: 'campaigns_target_technical_count_check']
  `(((target_logistics_count IS NULL) OR (target_logistics_count >= 0)))` [name: 'campaigns_target_logistics_count_check']
  `(((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'OPEN'::character varying, 'ACTIVE'::character varying, 'COMPLETED'::character varying, 'CANCELLED'::character varying])::text[])))` [name: 'campaigns_status_check']
  `(((organizer_type)::text = ANY ((ARRAY['INDIVIDUAL'::character varying, 'ORGANIZATION'::character varying])::text[])))` [name: 'campaigns_organizer_type_check']
  `(((fundraising_goal IS NULL) OR (fundraising_goal > (0)::numeric)))` [name: 'campaigns_fundraising_goal_check']
  `(((estimated_budget IS NULL) OR (estimated_budget >= (0)::numeric)))` [name: 'campaigns_estimated_budget_check']
  `(((contribution_mode)::text = 'VOLUNTEER_ONLY'::text))` [name: 'campaigns_contribution_mode_check']
  `(((target_technical_count IS NULL) OR (target_logistics_count IS NULL) OR (((target_technical_count)::bigint + target_logistics_count) <= target_volunteer_count)))` [name: 'campaigns_check6']
  `((((contribution_mode)::text <> 'VOLUNTEER_ONLY'::text) OR ((fundraising_goal IS NULL) AND (fundraising_deadline IS NULL))))` [name: 'campaigns_check5']
  `((((contribution_mode)::text <> 'DONATION_ONLY'::text) OR ((COALESCE(target_volunteer_count, 0) = 0) AND (COALESCE(target_technical_count, 0) = 0) AND (COALESCE(target_logistics_count, 0) = 0))))` [name: 'campaigns_check4']
  `((((contribution_mode)::text = 'DONATION_ONLY'::text) OR ((target_volunteer_count IS NOT NULL) AND (target_volunteer_count >= 1))))` [name: 'campaigns_check3']
  `(((institutional_funding >= (0)::numeric) AND (sponsor_funding >= (0)::numeric)))` [name: 'campaigns_check2']
  `((end_date >= start_date))` [name: 'campaigns_check1']
  `((((organizer_type)::text = 'ORGANIZATION'::text) = (organization_id IS NOT NULL)))` [name: 'campaigns_check']
 }
 Note: 'CREATE UNIQUE INDEX campaigns_pkey ON dut_connect_midterm.campaigns USING btree (id)\nCREATE UNIQUE INDEX campaigns_proposal_id_key ON dut_connect_midterm.campaigns USING btree (proposal_id)\nCREATE UNIQUE INDEX campaigns_slug_key ON dut_connect_midterm.campaigns USING btree (slug)\nCREATE INDEX idx_campaigns_status ON dut_connect_midterm.campaigns USING btree (status)\nCREATE INDEX idx_campaigns_category ON dut_connect_midterm.campaigns USING btree (category_id)\nCREATE INDEX idx_campaigns_organization ON dut_connect_midterm.campaigns USING btree (organization_id)\nCREATE INDEX idx_campaigns_mode ON dut_connect_midterm.campaigns USING btree (contribution_mode)\nCREATE INDEX idx_campaigns_start ON dut_connect_midterm.campaigns USING btree (start_date)\nCREATE UNIQUE INDEX campaigns_seed_key_key ON dut_connect_midterm.campaigns USING btree (seed_key)'
}

Table dut_connect_midterm.meetings {
 id uuid [pk, not null]
 campaign_id uuid [not null]
 title varchar(200) [not null]
 description text
 meeting_type varchar(20) [not null]
 starts_at timestamptz [not null]
 ends_at timestamptz [not null]
 location varchar(300)
 meeting_url varchar(1000)
 created_by_user_id uuid [not null]
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 checks {
  `((length(TRIM(BOTH FROM title)) > 0))` [name: 'meetings_title_check']
  `(((meeting_type)::text = ANY ((ARRAY['ONLINE'::character varying, 'OFFLINE'::character varying])::text[])))` [name: 'meetings_meeting_type_check']
  `((((meeting_type)::text <> 'OFFLINE'::text) OR ((length(TRIM(BOTH FROM location)) > 0) AND (location IS NOT NULL))))` [name: 'meetings_check2']
  `((((meeting_type)::text <> 'ONLINE'::text) OR ((length(TRIM(BOTH FROM meeting_url)) > 0) AND (meeting_url IS NOT NULL))))` [name: 'meetings_check1']
  `((ends_at > starts_at))` [name: 'meetings_check']
 }
 Note: 'CREATE UNIQUE INDEX meetings_pkey ON dut_connect_midterm.meetings USING btree (id)\nCREATE INDEX idx_meetings_campaign_start ON dut_connect_midterm.meetings USING btree (campaign_id, starts_at, id)'
}

Table dut_connect_midterm.organization_members {
 organization_id uuid [not null]
 user_id uuid [not null]
 member_role varchar(20) [not null]
 joined_at timestamptz [not null]
 indexes {
  (organization_id, user_id) [pk, name: 'organization_members_pkey']
 }
 checks {
  `(((member_role)::text = ANY ((ARRAY['OWNER'::character varying, 'MANAGER'::character varying, 'MEMBER'::character varying])::text[])))` [name: 'organization_members_member_role_check']
 }
 Note: 'CREATE UNIQUE INDEX organization_members_pkey ON dut_connect_midterm.organization_members USING btree (organization_id, user_id)\nCREATE INDEX idx_organization_members_user ON dut_connect_midterm.organization_members USING btree (user_id)'
}

Table dut_connect_midterm.organization_types {
 id uuid [pk, not null]
 code varchar(50) [not null]
 name varchar(120) [not null]
 active boolean [not null, default: `true`]
 created_at timestamptz [not null]
 indexes {
  (code) [unique, name: 'organization_types_code_key']
 }
 Note: 'CREATE UNIQUE INDEX organization_types_pkey ON dut_connect_midterm.organization_types USING btree (id)\nCREATE UNIQUE INDEX organization_types_code_key ON dut_connect_midterm.organization_types USING btree (code)'
}

Table dut_connect_midterm.organizations {
 id uuid [pk, not null]
 name varchar(200) [not null]
 slug varchar(220) [not null]
 organization_type_id uuid [not null]
 description text
 status varchar(30) [not null]
 created_by_user_id uuid [not null]
 verified_by_user_id uuid
 verified_at timestamptz
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 seed_key varchar(100)
 indexes {
  (slug) [unique, name: 'organizations_slug_key']
  (seed_key) [unique, name: 'organizations_seed_key_key']
 }
 checks {
  `(((status)::text = ANY ((ARRAY['PENDING_VERIFICATION'::character varying, 'VERIFIED'::character varying, 'SUSPENDED'::character varying])::text[])))` [name: 'organizations_status_check']
  `((((status)::text = 'PENDING_VERIFICATION'::text) OR (verified_at IS NOT NULL)))` [name: 'organizations_check1']
  `(((verified_by_user_id IS NULL) = (verified_at IS NULL)))` [name: 'organizations_check']
 }
 Note: 'CREATE UNIQUE INDEX organizations_pkey ON dut_connect_midterm.organizations USING btree (id)\nCREATE UNIQUE INDEX organizations_slug_key ON dut_connect_midterm.organizations USING btree (slug)\nCREATE UNIQUE INDEX uk_organizations_name ON dut_connect_midterm.organizations USING btree (lower((name)::text))\nCREATE INDEX idx_organizations_status ON dut_connect_midterm.organizations USING btree (status)\nCREATE UNIQUE INDEX organizations_seed_key_key ON dut_connect_midterm.organizations USING btree (seed_key)'
}

Table dut_connect_midterm.profile_avatars {
 user_id uuid [pk, not null]
 image_data bytea [not null]
 updated_at timestamptz [not null]
 checks {
  `(((octet_length(image_data) >= 1) AND (octet_length(image_data) <= 262144)))` [name: 'ck_avatar_size']
 }
 Note: 'CREATE UNIQUE INDEX profile_avatars_pkey ON dut_connect_midterm.profile_avatars USING btree (user_id)'
}

Table dut_connect_midterm.proposals {
 id uuid [pk, not null]
 proposer_user_id uuid [not null]
 organizer_type varchar(20) [not null]
 organization_id uuid
 category_id uuid [not null]
 title varchar(200) [not null]
 summary varchar(500) [not null]
 description text [not null]
 expected_impact text
 contribution_mode varchar(30) [not null]
 start_date date [not null]
 end_date date [not null]
 application_deadline timestamptz
 fundraising_deadline timestamptz
 target_volunteer_count integer
 target_technical_count integer
 target_logistics_count integer
 volunteer_requirements text
 fundraising_goal numeric(19,0)
 institutional_funding numeric(19,0) [not null, default: `0`]
 sponsor_name varchar(200)
 sponsor_funding numeric(19,0) [not null, default: `0`]
 estimated_budget numeric(19,0)
 status varchar(20) [not null]
 rejection_reason varchar(1000)
 reviewed_by_user_id uuid
 reviewed_at timestamptz
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 checks {
  `(((target_volunteer_count IS NULL) OR (target_volunteer_count >= 0)))` [name: 'proposals_target_volunteer_count_check']
  `(((target_technical_count IS NULL) OR (target_technical_count >= 0)))` [name: 'proposals_target_technical_count_check']
  `(((target_logistics_count IS NULL) OR (target_logistics_count >= 0)))` [name: 'proposals_target_logistics_count_check']
  `(((status)::text = ANY ((ARRAY['PENDING'::character varying, 'APPROVED'::character varying, 'REJECTED'::character varying])::text[])))` [name: 'proposals_status_check']
  `(((organizer_type)::text = ANY ((ARRAY['INDIVIDUAL'::character varying, 'ORGANIZATION'::character varying])::text[])))` [name: 'proposals_organizer_type_check']
  `(((fundraising_goal IS NULL) OR (fundraising_goal > (0)::numeric)))` [name: 'proposals_fundraising_goal_check']
  `(((estimated_budget IS NULL) OR (estimated_budget >= (0)::numeric)))` [name: 'proposals_estimated_budget_check']
  `(((contribution_mode)::text = 'VOLUNTEER_ONLY'::text))` [name: 'proposals_contribution_mode_check']
  `(((target_technical_count IS NULL) OR (target_logistics_count IS NULL) OR (((target_technical_count)::bigint + target_logistics_count) <= target_volunteer_count)))` [name: 'proposals_check9']
  `((((contribution_mode)::text <> 'VOLUNTEER_ONLY'::text) OR ((fundraising_goal IS NULL) AND (fundraising_deadline IS NULL))))` [name: 'proposals_check8']
  `((((contribution_mode)::text <> 'DONATION_ONLY'::text) OR ((COALESCE(target_volunteer_count, 0) = 0) AND (COALESCE(target_technical_count, 0) = 0) AND (COALESCE(target_logistics_count, 0) = 0))))` [name: 'proposals_check7']
  `((((contribution_mode)::text = 'DONATION_ONLY'::text) OR ((target_volunteer_count IS NOT NULL) AND (target_volunteer_count >= 1))))` [name: 'proposals_check6']
  `(((institutional_funding >= (0)::numeric) AND (sponsor_funding >= (0)::numeric)))` [name: 'proposals_check5']
  `((end_date >= start_date))` [name: 'proposals_check4']
  `((((organizer_type)::text = 'ORGANIZATION'::text) = (organization_id IS NOT NULL)))` [name: 'proposals_check3']
  `((((status)::text <> 'REJECTED'::text) OR ((rejection_reason IS NOT NULL) AND (length(TRIM(BOTH FROM rejection_reason)) > 0))))` [name: 'proposals_check2']
  `((((status)::text = 'PENDING'::text) OR (reviewed_at IS NOT NULL)))` [name: 'proposals_check1']
  `(((reviewed_by_user_id IS NULL) = (reviewed_at IS NULL)))` [name: 'proposals_check']
 }
 Note: 'CREATE UNIQUE INDEX proposals_pkey ON dut_connect_midterm.proposals USING btree (id)\nCREATE INDEX idx_proposals_status_created ON dut_connect_midterm.proposals USING btree (status, created_at)\nCREATE INDEX idx_proposals_proposer ON dut_connect_midterm.proposals USING btree (proposer_user_id)'
}

Table dut_connect_midterm.published_activities {
 id uuid [pk, not null]
 category varchar(100) [not null]
 content jsonb [not null]
 published_on date [not null]
 image_url varchar(500) [not null]
 source_url varchar(1000) [not null]
 created_at timestamptz [not null, default: `now()`]
 indexes {
  (source_url) [unique, name: 'published_activities_source_url_key']
 }
 checks {
  `(((source_url)::text ~~ 'https://dut.udn.vn/%'::text))` [name: 'ck_activity_source']
  `(((content ? 'vi'::text) AND (content ? 'en'::text)))` [name: 'ck_activity_languages']
  `(((image_url)::text ~~ '/images/%'::text))` [name: 'ck_activity_image']
 }
 Note: 'CREATE UNIQUE INDEX published_activities_pkey ON dut_connect_midterm.published_activities USING btree (id)\nCREATE UNIQUE INDEX published_activities_source_url_key ON dut_connect_midterm.published_activities USING btree (source_url)\nCREATE INDEX idx_activities_publication ON dut_connect_midterm.published_activities USING btree (published_on DESC, id)\nCREATE INDEX idx_activities_category ON dut_connect_midterm.published_activities USING btree (category)'
}

Table dut_connect_midterm.refresh_tokens {
 id uuid [pk, not null]
 user_id uuid [not null]
 token_hash char(64) [not null]
 expires_at timestamptz [not null]
 revoked_at timestamptz
 replaced_by_token_id uuid
 created_at timestamptz [not null]
 indexes {
  (token_hash) [unique, name: 'refresh_tokens_token_hash_key']
 }
 Note: 'CREATE UNIQUE INDEX refresh_tokens_pkey ON dut_connect_midterm.refresh_tokens USING btree (id)\nCREATE UNIQUE INDEX refresh_tokens_token_hash_key ON dut_connect_midterm.refresh_tokens USING btree (token_hash)\nCREATE INDEX idx_refresh_tokens_user ON dut_connect_midterm.refresh_tokens USING btree (user_id)\nCREATE INDEX idx_refresh_tokens_expiry ON dut_connect_midterm.refresh_tokens USING btree (expires_at)'
}

Table dut_connect_midterm.skills {
 id uuid [pk, not null]
 name varchar(100) [not null]
 active boolean [not null, default: `true`]
 created_at timestamptz [not null]
 indexes {
  (name) [unique, name: 'skills_name_key']
 }
 Note: 'CREATE UNIQUE INDEX skills_pkey ON dut_connect_midterm.skills USING btree (id)\nCREATE UNIQUE INDEX skills_name_key ON dut_connect_midterm.skills USING btree (name)'
}

Table dut_connect_midterm.student_profiles {
 user_id uuid [pk, not null]
 faculty varchar(150) [not null]
 bio varchar(500)
 preferred_track varchar(20)
 experience text
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 checks {
  `(((preferred_track)::text = ANY ((ARRAY['TECHNICAL'::character varying, 'LOGISTICS'::character varying])::text[])))` [name: 'student_profiles_preferred_track_check']
 }
 Note: 'CREATE UNIQUE INDEX student_profiles_pkey ON dut_connect_midterm.student_profiles USING btree (user_id)'
}

Table dut_connect_midterm.student_skills {
 user_id uuid [not null]
 skill_id uuid [not null]
 indexes {
  (user_id, skill_id) [pk, name: 'student_skills_pkey']
 }
 Note: 'CREATE UNIQUE INDEX student_skills_pkey ON dut_connect_midterm.student_skills USING btree (user_id, skill_id)\nCREATE INDEX idx_student_skills_skill ON dut_connect_midterm.student_skills USING btree (skill_id)'
}

Table dut_connect_midterm.users {
 id uuid [pk, not null]
 student_id varchar(32) [not null]
 email varchar(255) [not null]
 password_hash varchar(255) [not null]
 full_name varchar(150) [not null]
 global_role varchar(20) [not null]
 status varchar(20) [not null]
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 indexes {
  (student_id) [unique, name: 'users_student_id_key']
  (email) [unique, name: 'users_email_key']
 }
 checks {
  `(((status)::text = ANY ((ARRAY['ACTIVE'::character varying, 'SUSPENDED'::character varying])::text[])))` [name: 'users_status_check']
  `(((global_role)::text = ANY ((ARRAY['ADMIN'::character varying, 'USER'::character varying])::text[])))` [name: 'users_global_role_check']
 }
 Note: 'CREATE UNIQUE INDEX users_pkey ON dut_connect_midterm.users USING btree (id)\nCREATE UNIQUE INDEX users_student_id_key ON dut_connect_midterm.users USING btree (student_id)\nCREATE UNIQUE INDEX users_email_key ON dut_connect_midterm.users USING btree (email)'
}

Table dut_connect_midterm.volunteer_registrations {
 id uuid [pk, not null]
 campaign_id uuid [not null]
 user_id uuid [not null]
 preferred_track varchar(20) [not null]
 assigned_track varchar(20)
 motivation varchar(1000) [not null]
 availability varchar(1000)
 status varchar(20) [not null]
 rejection_reason varchar(1000)
 reviewed_by_user_id uuid
 reviewed_at timestamptz
 created_at timestamptz [not null]
 updated_at timestamptz [not null]
 version bigint [not null]
 indexes {
  (campaign_id, user_id) [unique, name: 'uk_volunteer_campaign_user']
 }
 checks {
  `(((status)::text = ANY ((ARRAY['PENDING'::character varying, 'ACCEPTED'::character varying, 'REJECTED'::character varying, 'CANCELLED'::character varying])::text[])))` [name: 'volunteer_registrations_status_check']
  `(((rejection_reason IS NULL) OR (length(TRIM(BOTH FROM rejection_reason)) > 0)))` [name: 'volunteer_registrations_rejection_reason_check']
  `(((preferred_track)::text = ANY ((ARRAY['TECHNICAL'::character varying, 'LOGISTICS'::character varying])::text[])))` [name: 'volunteer_registrations_preferred_track_check']
  `((length(TRIM(BOTH FROM motivation)) > 0))` [name: 'volunteer_registrations_motivation_check']
  `((((status)::text = 'REJECTED'::text) = (rejection_reason IS NOT NULL)))` [name: 'volunteer_registrations_check3']
  `(((reviewed_by_user_id IS NULL) = (reviewed_at IS NULL)))` [name: 'volunteer_registrations_check2']
  `((((status)::text = ANY ((ARRAY['ACCEPTED'::character varying, 'REJECTED'::character varying])::text[])) = (reviewed_by_user_id IS NOT NULL)))` [name: 'volunteer_registrations_check1']
  `((((status)::text = 'ACCEPTED'::text) = (assigned_track IS NOT NULL)))` [name: 'volunteer_registrations_check']
  `(((assigned_track)::text = ANY ((ARRAY['TECHNICAL'::character varying, 'LOGISTICS'::character varying])::text[])))` [name: 'volunteer_registrations_assigned_track_check']
 }
